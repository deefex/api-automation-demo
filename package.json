{
  "name": "api-automation-demo",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript API automation portfolio project using Swagger Petstore",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit",
    "test": "npm run test:mock",
    "test:mock": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:all": "npm run test && npm run test:live"
  },
  "dependencies": {
    "axios": "^1.8.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "dotenv": "^16.4.7",
    "nock": "^14.0.1",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
